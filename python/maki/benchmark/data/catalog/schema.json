{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/dataset-manifest.schema.json",
  "title": "Dataset manifest",
  "description": "JSON schema for validating dataset manifests before parsing them into Dataset objects.",
  "type": "object",
  "required": [
    "schema_version",
    "datasets"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "datasets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dataset"
      }
    }
  },
  "$defs": {
    "dataset": {
      "type": "object",
      "required": [
        "id",
        "name",
        "domain",
        "data_type"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "data_type": {
          "type": "string",
          "minLength": 1
        },
        "organism": {
          "type": [
            "string",
            "null"
          ]
        },
        "assay": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dataset_file"
          }
        }
      }
    },
    "dataset_file": {
      "type": "object",
      "required": [
        "role",
        "url",
        "filename"
      ],
      "additionalProperties": true,
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "checksum": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/checksum"
            }
          ]
        }
      }
    },
    "checksum": {
      "type": "object",
      "required": [
        "algorithm",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
